over "quady"
{
    over "Physics"
    {
        def MjcActuator "front_left_hip_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 3
            uniform double mjc:forceRange:min = -3
            custom rel mjc:target
            prepend rel mjc:target = </quady/Physics/front_left_hip_pitch>
        }

        def MjcActuator "front_left_knee_pitch_actuator"
        {
