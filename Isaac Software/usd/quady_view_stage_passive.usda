#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def DistantLight "defaultLight"
    {
        float inputs:angle = 1
        float inputs:intensity = 3000
    }

    def Xform "Quady" (
        prepend references = @./quady_5/quady.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
