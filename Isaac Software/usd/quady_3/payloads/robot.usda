"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "quady" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "front_left_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_left_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_right_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_left_knee_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_knee_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_left_knee_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_right_knee_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_body" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "front_left_upper_leg" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_left_lower_leg" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "front_right_upper_leg" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_right_lower_leg" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rear_left_upper_leg" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_left_lower_leg" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rear_right_upper_leg" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_right_lower_leg" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }
}

