#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "quady"
    doc = """Generated from Composed Stage of root layer C:\\Users\\ethan\\AppData\\Local\\Temp\\tmpn75w85yc\\quady.usdc


Generated from Composed Stage of root layer C:\\Users\\ethan\\AppData\\Local\\Temp\\urdf_import_quady_hmh1p5v1\\usdex_quady\\quady.usdc


