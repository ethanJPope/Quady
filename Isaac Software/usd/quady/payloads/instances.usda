    def Xform "base_body" (
        prepend references = @./geometries.usd@</Geometries/base_body>
    )
    {
        over "base_body" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_body/VisualMaterials/dark_gray>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark_gray>
            )
            {
            }
        }
    }

