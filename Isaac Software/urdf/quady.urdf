<?xml version="1.0"?>
<robot name="quady">
  <!--
    Initial Quady URDF generated from the Fusion assembly on 2026-06-15.
    Coordinate frame: X forward, Y left, Z up.
    Visual meshes were exported from Fusion as assembly-positioned STL files in millimeters.
    Mesh scale converts millimeters to meters.
    Collision geometry intentionally uses simplified primitive boxes for stable simulation.
    Joint axes and origins come from Isaac Software/notes/link_joint_table.md.
  -->

  <material name="dark_gray">
    <color rgba="0.35 0.35 0.32 1.0"/>
  </material>

  <link name="base_body">
    <inertial>
      <origin xyz="-0.114966 0.040271 0.001584" rpy="0 0 0"/>
      <mass value="0.500"/>
      <inertia ixx="0.0020" ixy="0" ixz="0" iyy="0.0040" iyz="0" izz="0.0040"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/base_body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.114966 0.040271 0.001584" rpy="0 0 0"/>
      <geometry>
        <box size="0.195000 0.135000 0.030000"/>
      </geometry>
    </collision>
  </link>

